diff --git a/src/v2/strings.c b/src/v2/strings.c
index 43b62fd..a43f425 100644
--- a/src/v2/strings.c
+++ b/src/v2/strings.c
@@ -21,6 +21,47 @@
 #include "v2/strings.h"
 #include "utils.h"
 
+#ifdef _WIN32
+ssize_t getline(char **lineptr, size_t *n, FILE *stream) {
+    if (!lineptr || !n || !stream) return -1;
+
+    char *buf = *lineptr;
+    size_t size = *n;
+    int c = 0;
+    size_t len = 0;
+
+    if (buf == NULL || size == 0) {
+        size = 128;
+        buf = malloc(size);
+        if (!buf) return -1;
+        *lineptr = buf;
+        *n = size;
+    }
+
+    while ((c = fgetc(stream)) != EOF) {
+        if (len + 1 >= size) {
+            size *= 2;
+            char *newbuf = realloc(buf, size);
+            if (!newbuf) return -1;
+            buf = newbuf;
+            *lineptr = buf;
+            *n = size;
+        }
+
+        buf[len++] = c;
+
+        if (c == '\n')
+            break;
+    }
+
+    if (len == 0 && c == EOF)
+        return -1;
+
+    buf[len] = '\0';
+    return len;
+}
+#endif
+
 #define MAX_STRING_LEN      2048
 
 typedef struct _DataRef DataRef;
