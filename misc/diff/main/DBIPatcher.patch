diff --git a/src/utils.c b/src/utils.c
index 070d9c2..376d36f 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -9,17 +9,32 @@
 #include <stdio.h>
 #include <stdarg.h>
 
+#ifdef _WIN32
+#include <direct.h>
+#endif
+
 #include "utils.h"
 
 static int _mkpath(char* file_path, mode_t mode) {
     for (char* p = strchr(file_path + 1, '/'); p; p = strchr(p + 1, '/')) {
         *p = '\0';
+
+#ifdef _WIN32
+        if (_mkdir(file_path) == -1) {
+            if (errno != EEXIST) {
+                *p = '/';
+                return -1;
+            }
+        }
+#else
         if (mkdir(file_path, mode) == -1) {
             if (errno != EEXIST) {
                 *p = '/';
                 return -1;
             }
         }
+#endif
+
         *p = '/';
     }
     return 0;
