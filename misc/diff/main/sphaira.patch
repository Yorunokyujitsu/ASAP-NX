+
+void Menu::Update(Controller* controller, TouchInfo* touch) {
+    if (m_dirty) {
+        ScanRecords();
+    }
+
+    if (m_scanning) {
+        ScanSizeStep();
+    }
+
+    MenuBase::Update(controller, touch);
+    m_list->OnUpdate(controller, touch, m_index, m_view.size(), [this](bool touch, auto i) {
+        if (touch && m_index == i) {
+            FireAction(Button::A);
+        } else {
+            App::PlaySoundEffect(SoundEffect::Focus);
+            SetIndex(i);
+        }
+    });
+}
