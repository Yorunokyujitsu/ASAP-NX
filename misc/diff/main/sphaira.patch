+    if (m_view.empty()) {
+        const auto text = m_scanning ? "Calculating..."_i18n : "Empty..."_i18n;
+        gfx::drawTextArgs(vg, 845.f, GetY() + GetH() / 2.f, 36.f, NVG_ALIGN_CENTER | NVG_ALIGN_MIDDLE, theme->GetColour(ThemeEntryID_TEXT_INFO), "%s", text.c_str());
+        return;
