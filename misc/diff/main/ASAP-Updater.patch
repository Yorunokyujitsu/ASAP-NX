@@ -0,0 +1,57 @@
+#include "changelog_page.hpp"
+#include "utils.hpp"
+
+namespace i18n = brls::i18n;
+using namespace i18n::literals;
+
+ChangelogPage::ChangelogPage(const nlohmann::ordered_json& nxlinks) : AppletFrame(true, true)
+{
+    /* this->registerAction("brls/hints/exit"_i18n, brls::Key::PLUS, [] {
+        brls::Application::quit();
+        return true;
+    });
+
+    this->registerAction("brls/hints/back"_i18n, brls::Key::B, [] {
+        brls::Application::popView();
+        return true;
+    }); */
+
+    auto* list = new brls::List();
+
+    if (!nxlinks.contains("changelog") || !nxlinks["changelog"].is_object() || nxlinks["changelog"].empty()) {
+        list->addView(new brls::Label(brls::LabelStyle::SMALL, "menus/common/no_changelog"_i18n, true));
+    } else {
+        const auto& it = nxlinks["changelog"].begin();
+        const auto& entries = it.value();
+
+        /* std::string hos = util::getChangelogVersion(nxlinks);
+        std::string headerText = "menus/common/supported_hos"_i18n;
+        if (!hos.empty())
+            headerText += hos;
+
+        list->addView(new brls::Header(headerText)); */
+
+        std::string content;
+        bool isFirstLine = true;
+
+        for (const auto& line : entries) {
+            std::string text = line.get<std::string>();
+
+            if (text.empty()) {
+                content += "\n";
+                isFirstLine = true;
+                continue;
+            }
+
+            if (isFirstLine) {
+                content += "　• " + text + "\n";
+                isFirstLine = false;
+            } else {
+                content += "　  └ " + text + "\n";
+            }
+        }
+        list->addView(new brls::Label(brls::LabelStyle::SMALL, content, true));
+    }
+
+    this->setContentView(list);
+}
