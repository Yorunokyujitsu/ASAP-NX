+			const char* firstBreak = strchr(Docked_c, '\n');
+			const char* start = firstBreak ? firstBreak + 1 : nullptr;
+			const char* end = start ? strchr(start, '\n') : nullptr;
+			const std::string second_line = start ? std::string(start, end ? (end - start) : strlen(start)) : std::string();
+			const auto string_width = second_line.empty() ? 0 :
+				renderer->drawString(second_line.c_str(), false, x, y+fontsize, fontsize, renderer->a(0x0000)).first;
+			if (!block) {
+				if (laneCount == 2 || laneCount == 4) {
+					if ((linkRate * laneCount) < 40) renderer->drawString("\uE14C", false, x+(fontsize/2)+string_width, y+(fontsize*2), fontsize, renderer->a(0xF00F));
+					else renderer->drawString("\uE14B", false, x+(fontsize/2)+string_width, y+(fontsize*2), fontsize, renderer->a(0xF0F0));
+				}
+				else {
+					if (linkRate < 20) renderer->drawString("\uE14C", false, x+(fontsize/2)+string_width, y+(fontsize*2), fontsize, renderer->a(0xF00F));
+					else renderer->drawString("\uE14B", false, x+(fontsize/2)+string_width, y+(fontsize*2), fontsize, renderer->a(0xF0F0));
+				}
