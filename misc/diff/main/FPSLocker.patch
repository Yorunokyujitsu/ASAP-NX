+#pragma once
+#include <tesla.hpp>
+
+namespace tsl::elm {
+    class NoteHeader : public Element {
+    public:
+        NoteHeader(const std::string& title, bool hasSeparator = false, tsl::Color headerBarColor = {0xF, 0xF, 0xF, 0xF}) : m_text(title), m_hasSeparator(hasSeparator), m_headerBarColor(headerBarColor) {
+            m_isItem = false;
+        }
+
+        void draw(gfx::Renderer* renderer) override {
+            renderer->drawRect(getX() - 2, getBottomBound() - 30, 3, 23, m_headerBarColor);
+            renderer->drawString(m_text, false, getX() + 13, getBottomBound() - 12, 15, a(tsl::style::color::ColorText));
+            if (m_hasSeparator)
+                renderer->drawRect(getX(), getBottomBound(), getWidth(), 1, a(tsl::style::color::ColorFrame));
+        }
+
+        void layout(u16, u16, u16, u16) override {
+            auto* list = dynamic_cast<List*>(getParent());
+            const bool first = list && list->getIndexInList(this) == 0;
+            setBoundaries(getX(), getY(), getWidth(), first ? 20 : 40);
+        }
+
+        bool onClick(u64) override { return false; }
+        Element* requestFocus(Element*, FocusDirection) override { return nullptr; }
+        void setText(const std::string& text) { m_text = text; }
+        const std::string& getText() const { return m_text; }
+
+    private:
+        std::string m_text;
+        bool m_hasSeparator;
+        tsl::Color m_headerBarColor;
+    };
+}
